# 阿里云 PostgreSQL 连接串
# 用 psycopg3(SQLAlchemy 2.0 原生支持,无需 pg_config)
# 格式:postgresql+psycopg://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgresql+psycopg://username:password@pgm-xxx.pg.rds.aliyuncs.com:5432/secondlook
# 启动时是否 drop_all + create_all 重建表(会清空数据)
# 默认 false:仅 create_all 幂等建表,数据保留
# schema 变更时临时设为 true,改完记得改回 false
DB_REBUILD_ON_START=false

# 应用配置
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
# 日志级别(DEBUG/INFO/WARNING/ERROR),留空则按 APP_DEBUG 决定
# 排查 Qoder CLI 认证等问题时建议设为 DEBUG,能看到 bridge 日志增量等诊断输出
LOG_LEVEL=

# JWT 密钥(阶段 6 用,先占位)
JWT_SECRET=change_me_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# 应用基础 URL(用于邮件中的验证/重置链接)
APP_BASE_URL=http://localhost:5173

# GitHub OAuth(阶段 6 用,留空则 /auth/oauth/github 报错)
# 在 https://github.com/settings/developers 创建 OAuth App 获取
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:5173/auth/github/callback

# Gitee OAuth(留空则 /auth/oauth/gitee 与 /git/gitee/* 报错)
# 在 https://gitee.com/oauth/applications 创建第三方应用获取
# 权限勾 user_info + projects;回调地址填 http://localhost:5173/auth/gitee/callback
GITEE_OAUTH_CLIENT_ID=
GITEE_OAUTH_CLIENT_SECRET=
GITEE_OAUTH_REDIRECT_URI=http://localhost:5173/auth/gitee/callback

# 调用 Git 平台接口时,传输层失败(连不上/超时/平台 5xx)后的额外重试次数
# 到 github.com 的链路偶发抖动(RTT 2-5s、TLS 握手被重置),默认重试 2 次;
# 只有"重复发送安全"的请求才重试:单次有效的授权码换 token 不会重发
# (0=不重试;网络类故障最终以 502/504 提示"稍后重试",不会伪装成 400 配置错误)
GIT_OAUTH_MAX_RETRIES=2

# 调用 Git 平台接口走的代理(只作用于 GitHub/Gitee 的 OAuth 与 API 调用)
# 典型场景:本机到 github.com 的 TLS 握手被链路卡住(10s 无响应 → 504),
# 而 Gitee 国内直连正常 —— 填本地代理的 HTTP 混合端口即可,如 Clash 的
# http://127.0.0.1:7890。不要挂全局 HTTPS_PROXY:那会连带改变 LLM/沙箱/ACP
# 的出站路径。留空则沿用系统 HTTP_PROXY/HTTPS_PROXY 环境变量
GIT_OAUTH_PROXY=

# Git provider access_token 加密密钥(Fernet,32 字节 base64)
# 用于加密 GitHub / Gitee 的 access_token(存到 user_git_bindings 表)
# 留空则启动时自动生成(开发期方便,但每次重启都会变,导致已存的 token 无法解密)
# 生产环境必须固定!用 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" 生成
GITHUB_TOKEN_SECRET=

# LLM 配置(阶段 1:开发期写死一个 provider,阶段 6 起用户可配)
# provider id,对应 models_catalog.json 中的 llmProviders[].id
LLM_PROVIDER=dashscope
# API Key(从厂商控制台获取)
LLM_API_KEY=sk-xxxxx
# 模型 id,对应 models_catalog.json 中的 models[].id
LLM_MODEL=qwen3.6-flash
# 是否启用思考(混合思考模型可开关,仅思考模型强制开启)
LLM_ENABLE_THINKING=true

# 仓库克隆临时目录(阶段 1:本地 clone,阶段 2 起改沙箱)
REPO_CLONE_DIR=./_repos

# ---- 仓库缓存(bare cache) ----
# 同一仓库跨任务复用:首次全量 clone --bare 入缓存,之后秒级本地克隆 + 按需 fetch 增量更新
# local 模式缓存开关(默认开;缓存任何失败自动降级全量克隆,不阻塞任务)
REPO_CACHE_ENABLED=true
# 缓存根目录(后端本机路径;Windows 建议短路径。生产可指向独立可写 volume)
REPO_CACHE_DIR=./_repo_cache
# 缓存新鲜度 TTL(秒):命中后距上次 fetch 未超此值直接复用,超了才增量 fetch
REPO_CACHE_FETCH_TTL=300
# 缓存总大小上限(GB),超限按最久未用 LRU 淘汰(1h 内用过的不会被淘汰)
REPO_CACHE_MAX_GB=5
# sandbox 模式缓存开关(默认关!开启前必须先在 Server [storage].allowed_host_paths
# 放行缓存目录前缀,见 docs/opensandbox-deploy.md 第 3.5 节)
REPO_CACHE_SANDBOX_ENABLED=false
# 缓存在 Server 宿主机上的绝对路径(注意:是 Server 机器路径,不是后端本地路径!
# 与 SANDBOX_SSH_KEY_HOST_PATH 同语义;留空则 sandbox 模式缓存不生效)
REPO_CACHE_SANDBOX_HOST_DIR=

# ---- 工作区保留 ----
# 任务完成后 session(含克隆的工作区)保留秒数,超时后惰性清理(清理前自动兜底导出 diff)
WORKSPACE_TTL_AFTER_COMPLETE=86400

# 用户上传 skill 存储目录(默认相对后端运行目录)
# 内置 skill 始终在代码目录 backend/skills/,不经过此配置
# 生产环境可指向独立可写 volume,如 USER_SKILLS_DIR=/data/secondlook/user_skills
USER_SKILLS_DIR=./user_skills

# 用户 skill 上传限制(单位 MB / 条,安全边界,默认值见 app/config.py)
# zip 本体上限(默认 50MB)
SKILL_MAX_ZIP_SIZE_MB=50
# 解压后总大小上限(默认 200MB,为 50MB zip 预留约 4 倍解压空间)
SKILL_MAX_EXTRACT_SIZE_MB=200
# zip 内单文件上限(默认 20MB)
SKILL_MAX_SINGLE_FILE_SIZE_MB=20
# 条目数上限,含附加资源(默认 100)
SKILL_MAX_FILES=100
# 管理界面单文件内容读取预览上限(默认 20MB,与单文件上传上限对齐)
SKILL_MAX_READ_SIZE_MB=20
# 管理界面文件列表条目数上限(防御异常目录,默认 200)
SKILL_MAX_LISTED_FILES=200
# 附加资源额外允许的扩展名(逗号分隔,追加到内置白名单之上,默认含常见图片格式)
# 内置白名单见 app/skills/uploader.py;不建议追加 .svg(可内嵌脚本,XSS 风险)
SKILL_ALLOWED_EXTENSIONS_EXTRA=.png,.jpg,.jpeg,.webp,.gif

# 工作区文件下载单文件上限(MB,默认 50)
# 二进制文件(docx/pdf/图片…)不进在线预览,只能下载;这条同时兜住超大文件被
# 整份拉回后端的内存/带宽风险,超限返回 413(请回源仓库获取)
WORKSPACE_DOWNLOAD_MAX_MB=50

# 沙箱配置(阶段 2 起)
# mode: local(本地模式,不用沙箱,在宿主机文件系统直接执行,适合开发/调试)/ sandbox(连真实 OpenSandbox Server)
# 注意:local 模式下 LLM 生成的代码/命令在宿主机直接执行,无隔离边界,请勿用于生产或审计不可信仓库
SANDBOX_MODE=local
# OpenSandbox Server 地址(部署在 Linux 服务器上)
# 形如 http://your-server-ip:8080
SANDBOX_SERVER_URL=http://localhost:8080
# Server 鉴权 API Key(对应 server 配置 [server].api_key,留空则不鉴权)
SANDBOX_API_KEY=
# 沙箱镜像:必须预装 git / ripgrep(rg) / python3 / awk / coreutils
# 官方 ubuntu 镜像不含 git 和 rg,需按 docs/opensandbox-deploy.md 构建自定义镜像
SANDBOX_IMAGE=ubuntu
# 沙箱超时(分钟)
SANDBOX_TIMEOUT_MINUTES=30
# 沙箱续期间隔(分钟):会话被访问时距上次续期超过此值就自动 renew TTL,
# 防长任务(多轮协作/用户等待/CLI 长执行)拖过 TTL 被 Server 回收(回收后命令 404)
SANDBOX_RENEW_INTERVAL_MINUTES=5
# CLI 挂死兜底(session/prompt 无数据事件 idle 超时,秒,0=关闭):
# 无活动工具(等模型输出)用 OUTPUT 阈值;有工具在跑(长命令)用 TOOL 阈值
ACP_IDLE_TIMEOUT_OUTPUT_SECONDS=300
ACP_IDLE_TIMEOUT_TOOL_SECONDS=1800
# 是否走 Server 代理访问沙箱(跨机部署必须为 true;本机部署 true 也能用)
# true=所有沙箱请求经 Server 8080 转发,后端只需连 Server 一个端口
# false=SDK 直连沙箱容器端口(需后端能访问 Server 容器端口范围)
SANDBOX_USE_SERVER_PROXY=true
# Server 宿主机上的 SSH key 目录(可选,只读挂载到沙箱 /home/user/.ssh 供 git clone SSH 协议用)
# 这是 Server 机器上的路径,不是后端本地路径!必须用绝对路径(如 /home/admin/.ssh),不要用 ~
# 留空不挂载;需在 server [storage].allowed_host_paths 放行该路径前缀
SANDBOX_SSH_KEY_HOST_PATH=
# 沙箱资源限制(可选,传给 SDK resource 参数,如 cpu=2 memory=4Gi)
SANDBOX_CPU=
SANDBOX_MEMORY=

# ---- local 模式安全策略 ----
# .git 目录写保护(防 LLM 篡改 git 历史)
SANDBOX_LOCAL_PROTECT_GIT=true
# 受保护的只读目录(逗号分隔,写操作拒绝)
SANDBOX_LOCAL_READONLY_PATHS=.vscode,.trae,.idea
# 安全命令前缀(逗号分隔,直接执行不拦截)
SANDBOX_LOCAL_SAFE_COMMANDS=git status,git diff,git log,git show,git branch,git remote,ls,cat,head,tail,wc,grep,find,rg,fd,python,python3,pip,pip3,node,npm,npx,echo,printf,test,mkdir -p,touch,cp -r,mv
# 危险命令正则(逗号分隔,匹配时推前端弹窗让用户确认)
SANDBOX_LOCAL_DANGEROUS_COMMANDS=rm\s+-rf\s+/,rm\s+-rf\s+~,rm\s+-rf\s+\*,mkfs,dd\s+if=,:\(\)\{\s*:\|:\s*&\s*\};:,curl\s+.*\|\s*(ba)?sh,wget\s+.*\|\s*(ba)?sh,chmod\s+777\s+/,netcat|nc\s+-l,sudo\s+,shutdown|reboot|halt|poweroff
# 平台原生隔离(macOS: sandbox-exec / Linux: bwrap,检测到工具时自动包装命令)
# Windows 无原生沙箱,此配置项无效
SANDBOX_LOCAL_NATIVE_ISOLATION=true

# Qoder CLI 执行器配置(task.executor=qoder_cli 时生效)
# qodercli 可执行文件名/路径(沙箱内 PATH 查找或绝对路径)
# 沙箱镜像预装时填 qodercli;若用其他路径,改这里
QODER_CLI_BIN=qodercli
# qodercli 安装命令(沙箱内未检测到 qodercli 时执行,留空则不自动安装)
# 前提:沙箱镜像已装 Node.js >= 20.0.0(见 docs/opensandbox-deploy.md 2.3 节)
# 推荐在镜像中预装 qodercli,避免每次任务都拉 npm 包(且 BRIDGE_STARTUP_TIMEOUT=30s 可能不够)
QODER_CLI_INSTALL_CMD=npm install -g @qoder-ai/qodercli

# DeepSeek Harness CLI 执行器配置(task.executor=deepseek_cli 时生效,
# 开源 https://github.com/deepseek-ai/deepseek-harness)
# dsh 可执行文件名/路径(沙箱内 PATH 查找或绝对路径)
# npm 包名 @deepseek-ai/dsh,bin 名为 dsh(dsh --profile acp 启动随附的 stdio ACP 服务)
DEEPSEEK_CLI_BIN=dsh
# dsh 安装命令(沙箱内未检测到 dsh 时执行,需沙箱镜像有 Node.js)
# 推荐在镜像中预装 dsh,避免每次任务都拉 npm 包(BRIDGE_STARTUP_TIMEOUT=30s 可能不够)
DEEPSEEK_CLI_INSTALL_CMD=npm install -g @deepseek-ai/dsh
# 凭证说明:用户在「智能体配置」页面填写 api_key / base_url 两个字段,
# 后端经 DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL 环境变量注入到 bridge 进程
# (由 registry 的 credential_env 静态映射,base_url 留空用 DeepSeek 官方端点)。
# 模型/思考强度:dsh ACP 模式不接受 --model CLI 参数,经 session/set_config_option
# 在 session/new 后设置(configId 为 model / reasoning_effort),值来自 task.params。
# 权限模式:DSH_PERMISSION_MODE 由 wrapper 的 credential_env_builder 按
# task.params._executor_command_confirm 动态注入:
#   always_approve(默认)→ danger-full-access(审批策略 never,跳过危险命令确认)
#   per_command          → 不注入,保持 dsh 默认 workspace-write(危险命令发
#                          session/request_permission,前端弹窗确认)

# Codex CLI 执行器配置(task.executor=codex_cli 时生效,OpenAI 官方 https://github.com/openai/codex,Apache-2.0)
# codex 可执行文件名/路径(沙箱内 PATH 查找或绝对路径)
# npm 包名 @openai/codex,bin 名为 codex(codex exec --json 非交互模式)
CODEX_CLI_BIN=codex
# codex 安装命令(沙箱内未检测到 codex 时执行,需沙箱镜像有 Node.js >= 16)
# 推荐在镜像中预装 codex,避免每次任务都拉 npm 包(BRIDGE_STARTUP_TIMEOUT=30s 可能不够)
CODEX_CLI_INSTALL_CMD=npm install -g @openai/codex
# 凭证说明:用户在「智能体配置」页面填写 api_key / base_url / model / wire_api 四个字段,
# 后端经 CODEX_API_KEY 环境变量注入 API Key(由 registry 的 credential_env 静态映射)。
# 模型/provider/base_url/wire_api 经 pre_bridge_hook 写入 ~/.codex/config.toml
# (env_key="CODEX_API_KEY" 指向 API Key 环境变量)。
# 与 Qoder/DeepSeek 不同:Codex 不原生支持 ACP,通过 codex_bridge.py 翻译 codex exec --json JSONL → ACP。
# 默认值:CODEX 默认模型 gpt-5,默认 wire_api=responses(Responses API)。
