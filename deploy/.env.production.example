# ============================================================
# SecondLook 生产部署配置模板
# 使用:
#   cp .env.production.example .env.production
#   然后编辑本文件,最后 bash deploy.sh 一键部署
#
# 注意:
#   - 值中避免使用 #、$、空格等特殊字符(会被 shell source 展开)
#   - 密码/密钥建议用单引号包裹,如 DATABASE_URL='postgresql+psycopg://u:p@host:5432/db'
# ============================================================

# ---------- 数据库(阿里云 RDS PostgreSQL) ----------
# 格式:postgresql+psycopg://用户名:密码@主机:端口/数据库名
# 后端与 RDS 同 VPC 时用内网地址;否则用公网地址并在 RDS 白名单放行服务器 IP
# 公网连接若 RDS 要求 SSL,在连接串末尾追加 ?sslmode=require
DATABASE_URL=postgresql+psycopg://secondlook:your_password@pgm-xxx.pg.rds.aliyuncs.com:5432/secondlook
# 仅首次建表/清空数据时设 true,正常部署保持 false(启动时幂等 create_all + 迁移)
DB_REBUILD_ON_START=false

# ---------- 应用 ----------
APP_ENV=production
APP_DEBUG=false
# 对外访问地址(邮件验证/重置链接用):有域名填域名,没有填 http://服务器公网IP
APP_BASE_URL=http://your-server-ip
# 出题 & 练习功能总开关
PRACTICE_ENABLED=true

# ---------- 安全(生产必须修改!) ----------
# JWT 密钥:openssl rand -hex 32
JWT_SECRET=change_me_in_production
# Git access_token 加密密钥(Fernet):留空则每次重启自动生成,已存 token 全部失效!
# 生成:python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GITHUB_TOKEN_SECRET=

# ---------- OAuth(可选,不配则对应登录方式不可用) ----------
# 回调地址必须与下方 VITE_GITHUB_OAUTH_REDIRECT_URI 完全一致
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://your-server-ip/auth/github/callback

GITEE_OAUTH_CLIENT_ID=
GITEE_OAUTH_CLIENT_SECRET=
GITEE_OAUTH_REDIRECT_URI=http://your-server-ip/auth/gitee/callback

# 调用 Git 平台接口时传输层失败(连不上/超时/平台 5xx)后的额外重试次数。
# 国内服务器到 github.com 链路抖动常见,默认 2 次;只有重复发送安全的请求才重试
# (单次有效的授权码换 token 不重发)。网络类故障返回 502/504 提示稍后重试。
GIT_OAUTH_MAX_RETRIES=2

# ---------- LLM(生产环境用户也可在「模型配置」页面自行管理) ----------
LLM_PROVIDER=dashscope
LLM_API_KEY=sk-xxxxx
LLM_MODEL=qwen3.6-flash
LLM_ENABLE_THINKING=true

# ---------- 沙箱(OpenSandbox,部署在另一台服务器) ----------
SANDBOX_MODE=sandbox
# 另一台 OpenSandbox Server 地址
SANDBOX_SERVER_URL=http://opensandbox-server-ip:8080
# 对应 server 配置 [server].api_key,留空则不鉴权
SANDBOX_API_KEY=
# 预装 git/ripgrep/python3 的自定义镜像(见 docs/opensandbox-deploy.md)
SANDBOX_IMAGE=your-custom-sandbox-image
# 跨机部署必须为 true
SANDBOX_USE_SERVER_PROXY=true

# ---------- 交付物存储后端(Stage 1 永久层) ----------
# 用户上传的任务交付物必须长期保留(失败重试 / resume 复用,agent 无法自行重新获取)
# 后端:local=本地磁盘(单节点,须挂 data 持久卷) / s3=S3 兼容对象存储(多节点/可扩展)
STORAGE_BACKEND=local
# local 后端目录:必须用绝对路径(相对路径按进程 CWD 漂移),且与 docker-compose 挂卷路径一致
# (统一数据根 backend/data/ 下的 uploads 子目录)
UPLOADS_DIR=/app/backend/data/uploads
# --- 以下仅 STORAGE_BACKEND=s3 时需配置(MinIO / 阿里云 OSS S3 兼容端点 / AWS S3) ---
# 端点(自建/云上兼容端点,如 https://oss-cn-hangzhou.aliyuncs.com 或 http://minio:9000);留空用 AWS S3
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 对象 key 前缀(以 / 结尾)
S3_PREFIX=uploads/

# ---------- 交付物保留 / GC ----------
# 后台周期清理:任务进入终态(completed/failed)且超过保留天数,或孤儿上传超期,才删除
UPLOAD_GC_ENABLED=true
UPLOAD_RETENTION_DAYS=30
UPLOAD_GC_INTERVAL_HOURS=24

# ---------- 前端构建期变量(VITE_*,修改后需重新 bash deploy.sh 构建) ----------
VITE_GITHUB_OAUTH_CLIENT_ID=
VITE_GITHUB_OAUTH_REDIRECT_URI=http://your-server-ip/auth/github/callback
VITE_GITEE_OAUTH_CLIENT_ID=
VITE_GITEE_OAUTH_REDIRECT_URI=http://your-server-ip/auth/gitee/callback

# ---------- 部署 ----------
# 对外暴露的 HTTP 端口(80 被占用时改如 8080)
HTTP_PORT=80
