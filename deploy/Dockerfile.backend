# SecondLook 后端镜像(Python 3.13 + uvicorn)
# 构建:docker build -f deploy/Dockerfile.backend -t secondlook-backend .
FROM python:3.13-slim

# git:沙箱未启用时本地 clone / 部分工具链需要;curl:可选排查用
# 国内服务器直连 deb.debian.org 极慢(实测 git 包 8.8MB 重试 1h+),先换阿里云镜像源
# Debian 13(trixie)用 deb822 格式,源列表在 /etc/apt/sources.list.d/debian.sources
RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends git curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/backend

# 先装依赖,利用 Docker 层缓存(requirements.txt 不变时不会重装)
# 依赖下载走国内镜像源(下方 PIP_INDEX_URL),直连 pypi.org 易超时
COPY backend/requirements.txt .
# 镜像源开成构建参数:ARG 声明在 COPY 之后,覆盖它只失效 pip 这一层。
# 主源失败自动用备用源重试:阿里云会把 PyPI 的 simple 页原样同步(含 data-core-metadata
# 声明),但 pydantic-core 等包的 .whl.metadata 侧车文件(PEP 658)没同步下来 —— pip 23.1+
# 先取 metadata 面,404 直接报错且不回落整包(见 pip/_internal/operations/prepare.py,
# 该下载无 try/except)。清华源不把该属性写进 HTML,pip 就会下整包,因此做备源。
# 临时手工覆盖:docker compose build --build-arg PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple backend
ARG PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
ARG PIP_INDEX_FALLBACK=https://pypi.tuna.tsinghua.edu.cn/simple
RUN pip install --no-cache-dir --retries 3 --timeout 60 -r requirements.txt -i ${PIP_INDEX_URL} \
    || pip install --no-cache-dir --retries 3 --timeout 60 -r requirements.txt -i ${PIP_INDEX_FALLBACK}

COPY backend/ .

# 非 root 运行 + 预创建可写目录
# (named volume 首次挂载会继承这些目录的所有权,data 必须可写;
#  不预建则以 root 创建,uid 1000 无写权限,上传直接失败)
RUN useradd -m -u 1000 appuser \
    && mkdir -p logs data \
    && chown -R appuser:appuser /app/backend
USER appuser

EXPOSE 8000

# 重要:出题 job 与 SSE 事件流是进程内存态,必须单 worker,禁止 --workers N
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=5 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3)"
